{
  "expo": {
    "name": "Cleandoku",
    "slug": "clean-sudoku",
    "version": "1.0.0",
    "scheme": "sudoku",
    "orientation": "portrait",
    "icon": "./assets/cleandoku-launcher.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.cleansudoku.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E8F1F9",
        "foregroundImage": "./assets/cleandoku-adaptive-foreground.png",
        "monochromeImage": "./assets/cleandoku-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7719a60e-cbaa-4d33-96ce-6b0dc553fd86"
      }
    },
    "owner": "rahulaswin"
  }
}
